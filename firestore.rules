rules_version = '2';
// 專案 cb-working-base 的 Firestore 安全規則（同一個專案有兩個應用程式共用，部署時會整份覆蓋，兩段都要保留）
service cloud.firestore {
  match /databases/{database}/documents {

    // 即時文字雲：任何人可讀、可新增，但不能修改或刪除別人的詞
    // 老師要清空資料時，請 Claude 透過 Firebase MCP 刪除（MCP 用老師帳號，不受此規則限制）
    match /wordcloud_words/{document} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['word', 'room', 'createdAt'])
        && request.resource.data.word is string
        && request.resource.data.word.size() >= 1
        && request.resource.data.word.size() <= 20
        && request.resource.data.room is string
        && request.resource.data.room.size() >= 1
        && request.resource.data.room.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // 小一打怪獸（grade1-games）答錯清單：只有登入的家長本人，可以讀寫自己帳號底下的資料
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 小一打怪獸「連線對戰」房間：rooms/{4 位數房號}
    // 小朋友用匿名登入（不用帳號）；房主、加入的同學只能改自己那一邊的資料；超過 3 小時沒動的房間可以重開或刪掉
    match /rooms/{code} {
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function isHost() { return request.auth.uid == resource.data.host.uid; }
      function isGuest() { return resource.data.guest != null && request.auth.uid == resource.data.guest.uid; }
      function stale() { return resource.data.updated < request.time - duration.value(3, 'h'); }
      function okRoom(d) {
        return d.keys().hasOnly(['game', 'level', 'seed', 'state', 'n', 'updated', 'host', 'guest', 'ah', 'ag', 'ph', 'pg', 'em'])
          && d.game is string && d.game.size() <= 30 && d.host.name is string && d.host.name.size() <= 20
          && (d.guest == null || (d.guest.name is string && d.guest.name.size() <= 20));
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && code.matches('^[0-9]{4}$')
        && request.resource.data.host.uid == request.auth.uid && okRoom(request.resource.data);
      allow update: if request.auth != null && okRoom(request.resource.data) && (
           (isHost() && changed().hasOnly(['game', 'level', 'seed', 'state', 'n', 'updated', 'guest', 'ah', 'ag', 'ph', 'em']))
        || (isGuest() && changed().hasOnly(['guest', 'ag', 'pg', 'em', 'updated']))
        || (resource.data.guest == null && request.resource.data.guest.uid == request.auth.uid && changed().hasOnly(['guest', 'updated']))
        || (stale() && request.resource.data.host.uid == request.auth.uid));
      allow delete: if request.auth != null && (isHost() || stale());
    }

    // 其他集合預設禁止存取
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
